# [execute] build on a go project
exec bky-c build in/main.go got/x.wasm

# [check] binary is reproducibly built
bin-eq want/x.wasm got/x.wasm

# [execute] build with one missing arg
! exec bky-c build in/main.go

# [check] assert stderr contains error output
stderr 'accepts 2 arg\(s\), received 1'

# [execute] build with two missing args
! exec bky-c build

# [check] assert stderr contains error output
stderr 'accepts 2 arg\(s\), received 0'
